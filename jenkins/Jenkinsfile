
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        AWS_DEFAULT_REGION = 'us-east-1'
        TF_IN_AUTOMATION = 'true'
        TF_INPUT = 'false'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Environment') {
            steps {
                sh '''
                    java -version
                    git --version
                    mvn -version
                    docker --version
                    docker compose version
                    terraform version
                    ansible-playbook --version
                    aws sts get-caller-identity
                '''
            }
        }

        stage('Terraform Init') {
            steps {
                dir('terraform') {
                    sh 'terraform init -input=false -no-color'
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir('terraform') {
                    sh 'terraform validate -no-color'
                }
            }
        }


	stage('Terraform Plan') {
	    steps {
	        dir('terraform') {
	            withEnv(["TF_VAR_my_ip=${params.SSH_CIDR}"]) {
	                sh '''
	                    terraform plan \
	                      -input=false \
	                      -no-color \
	                      -out=tfplan

	                    terraform show -no-color tfplan
	                '''
	            }
	        }
	    }
	}

	stage('Approve Terraform Apply') {
            when {
                expression {
                    return params.APPLY_TERRAFORM &&
                        currentBuild.getBuildCauses(
                            'hudson.model.Cause$UserIdCause'
                        ).size() > 0
                }
        }
	    steps {
	        timeout(time: 10, unit: 'MINUTES') {
	            input(
	                message: 'Review the Terraform plan before applying infrastructure changes.',
	                ok: 'Approve Terraform Apply',
	                submitter: 'jenkins'
	            )
	        }
	    }
	}


	stage('Terraform Apply') {
	    when {
	        expression {
	            return params.APPLY_TERRAFORM &&
	                currentBuild.getBuildCauses(
	                    'hudson.model.Cause$UserIdCause'
	                ).size() > 0
	        }
	}
	    steps {
	        dir('terraform') {
	            sh '''
	                terraform apply \
	                  -input=false \
	                  -no-color \
	                  tfplan
	            '''
	        }
	    }
	}

        stage('Ansible Configuration') {
            steps {
                sh 'sudo -n /usr/local/sbin/run-capstone-ansible'
            }
        }

        stage('Build Java Application') {
            steps {
                dir('java') {
                    sh 'mvn -B clean package'
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                sh 'docker compose -p devops-capstone build'
            }
        }

        stage('Deploy Applications') {
            steps {
                sh '''
                    docker compose -p devops-capstone up -d \
                      --no-build --remove-orphans
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    docker compose -p devops-capstone ps

                    curl --fail --silent --show-error \
                      http://127.0.0.1:8081/ > /dev/null

                    curl --fail --silent --show-error \
                      http://127.0.0.1:8082/ > /dev/null
                '''
            }
        }
    }

	parameters {
	    string(
	        name: 'SSH_CIDR',
	        defaultValue: '102.216.182.224/32',
	        description: 'Approved public IP CIDR for EC2 SSH access'
	    )

	    booleanParam(
	        name: 'APPLY_TERRAFORM',
	        defaultValue: false,
	        description: 'Request approval before applying Terraform changes'
	    )
	}

    post {
        success {
            echo 'Terraform, Ansible and application deployment completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
}
